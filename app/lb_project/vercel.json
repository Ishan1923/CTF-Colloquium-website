{
  "version": 2,
  "builds": [
    {
      "src": "app/lb_project/lb_project/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app/lb_project/lb_project/wsgi.py"
    }
  ]
}
